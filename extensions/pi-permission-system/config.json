{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-permission-system/main/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "toolInputPreviewMaxLength": 400,
  "toolTextSummaryMaxLength": 120,
  "piInfrastructureReadPaths": [],
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.npmrc": "deny",
      "~/.git-credentials": "deny",
      "~/.netrc": "deny",
      "~/.kube/config": "deny"
    },
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "external_directory": "allow",
    "mcp": {
      "*": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "bash": {
      "*": "allow",
      "git push *": "ask",
      "git pull *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git restore *": "ask",
      "git commit *": "ask",
      "pnpm install *": "ask",
      "pnpm add *": "ask",
      "pnpm remove *": "ask",
      "pnpm up *": "ask",
      "npm install *": "ask",
      "npm add *": "ask",
      "npm remove *": "ask",
      "npm publish *": "ask",
      "curl *": "allow",
      "wget *": "allow",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "docker *": "ask",
      "kubectl *": "ask",
      "curl * | sh": "ask",
      "curl * | bash": "ask",
      "wget * | sh": "ask",
      "wget * | bash": "ask",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "chmod 777 *": "deny",
      "chown -R *": "deny",
      "mkfs*": "deny",
      "dd if=*": "deny",
      ":(){ :|:& };:": "deny",
      "git reset --hard *": "deny",
      "git clean -fdx*": "deny"
    }
  }
}
